# Backend de Cláriva — variables de entorno
# ───────────────────────────────────────────────────────────────────────────

# Base de datos. Es la MISMA que usa el monolito (single source of truth).
# En el cutover, el backend apunta a la DATABASE_URL de Postgres de Railway.
DATABASE_URL=postgresql://user:pass@host:5432/clariva

# Techo de conexiones (database-per-tenant). Ver docs/architecture.md
# "Techo de conexiones". Máx teórico ≈ TENANT_CLIENT_MAX×TENANT_CLIENT_POOL +
# CONTROL_DB_POOL, contra el max_connections del Postgres.
TENANT_CLIENT_MAX=20        # clientes Prisma de clínica cacheados a la vez (LRU)
TENANT_CLIENT_POOL=3        # connection_limit por clínica
TENANT_CLIENT_TTL_MS=300000 # expiración por inactividad del caché (5 min)
CONTROL_DB_POOL=10          # connection_limit del control-plane

# Secreto para firmar los JWT que emite el backend.
# IMPORTANTE: para que las sesiones del monolito y del backend sean
# intercambiables durante la transición, reutilizar el MISMO valor que
# NEXTAUTH_SECRET del monolito. (El backend cae a NEXTAUTH_SECRET si no se define.)
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Orígenes del frontend permitidos por CORS (separados por coma, sin slash final).
# Para orígenes puntuales (p.ej. el dominio *.up.railway.app durante la transición).
CORS_ORIGINS=http://localhost:5173

# Dominio de la plataforma. Si se define, CORS permite el apex y CUALQUIER
# subdominio (cada clínica vive en <slug>.clariva.cl). Producción: clariva.cl
PLATFORM_DOMAIN=

PORT=4000
NODE_ENV=development

# Clave de cifrado AES-256-GCM (tokens de Twilio, refresh tokens de Google).
# DEBE ser EXACTAMENTE la misma que usa el monolito, o no se podrán descifrar
# los secretos ya guardados en la base.
ENCRYPTION_KEY=

# Secreto para el endpoint de sync de Google por cron (POST /google/sync).
CRON_SECRET=

# ── TuBot (canal WhatsApp) ─────────────────────────────────────────────────────
# Base de la API REST de TuBot, compartida por toda la plataforma. Las credenciales
# (API key, connectionId, webhookSecret, plantilla) son POR CLÍNICA y viven cifradas
# en su Configuracion (Super Admin). En dev apunta al mock (mock-tubot, puerto 4020).
# Ver docs/TUBOT_WHATSAPP.md.
TUBOT_BASE_URL=http://localhost:4020

# ── Meta Lead Ads (webhook nativo, compartido por toda la plataforma) ──────────
# Una sola App de Meta para toda la plataforma. Cada clínica autoriza su página
# y guarda su token de página en su Configuracion (encriptado). App secret valida
# la firma HMAC del webhook; el verify token lo defines tú (cualquier string) y
# debe coincidir con el que pegues en la config del webhook de la App de Meta.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Versión ÚNICA de la Graph API para TODAS las llamadas a Meta (CAPI web, emisor
# de etapas de CRM, webhook de Lead Ads). Opcional; por defecto v25.0.
META_GRAPH_VERSION=v25.0

# Google Calendar (opcional; solo si se usa la integración). El redirect URI
# debe apuntar al backend y estar registrado en Google Cloud Console:
#   https://<dominio-backend>/api/v1/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Dead-man's switch de la sincronización Google→Cláriva: si el último sync exitoso
# de un doctor mapeado es más viejo que esto (minutos), la clínica se marca como
# "desactualizada" en la agenda y en Configuración. Cron cada 15 min → default 60.
GOOGLE_SYNC_STALE_MINUTES=60

# ── Observabilidad (ver docs/OBSERVABILIDAD.md) ────────────────────────────────
# Sentry: reporte de errores 5xx y excepciones no manejadas. OPCIONAL: sin DSN,
# Sentry queda apagado y el backend funciona igual (solo logs). Cargar en Railway.
# DSN del proyecto de backend (Settings → Projects → clariva-backend → Client Keys).
SENTRY_DSN=
# Entorno que se muestra en Sentry (production / staging). Por defecto usa NODE_ENV.
SENTRY_ENVIRONMENT=production
# Nivel mínimo de log: debug | info | warn | error. Por defecto info.
LOG_LEVEL=info

# ── Backups lógicos por clínica (capa 2/3, ver docs/BACKUPS.md) ────────────────
# Clave de cifrado AES-256-GCM: 32 bytes en base64. Generar UNA vez y guardarla en
# un gestor de secretos (¡si se pierde, los backups son irrecuperables!):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=

# Destino S3-compatible (recomendado: Cloudflare R2). Endpoint SIN el bucket.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=clariva
# Credenciales del job DIARIO: escritura + lectura, SIN permiso de borrado (IAM).
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Incluir clínicas demo en el backup (por defecto NO: son efímeras). 1 para incluir.
BACKUP_INCLUDE_DEMOS=0

# Alertas (dead-man's switch + fallas). Coma. Si vacío, usa los PlatformAdmin activos.
BACKUP_ALERT_EMAILS=
# Umbral del dead-man's switch: alertar si pasaron más de estas horas sin backup OK.
BACKUP_MAX_AGE_HOURS=36

# ── Poda (SERVICIO SEPARADO: no cargar estas creds en el backend ni en el job diario) ──
# Credenciales con permiso de BORRADO, sólo para el servicio de poda.
BACKUP_S3_PRUNE_ACCESS_KEY_ID=
BACKUP_S3_PRUNE_SECRET_ACCESS_KEY=
# Retención GFS. Los object-lock del bucket deben durar MENOS que estas ventanas
# (ver docs/BACKUPS.md): 7d/30d/180d de lock vs 14d/56d/365d de retención.
BACKUP_RETAIN_DAILY=14
BACKUP_RETAIN_WEEKLY=8
BACKUP_RETAIN_MONTHLY=12
# Piso de seguridad: la poda se niega si dejaría una base con menos de esto.
BACKUP_PRUNE_MIN_KEEP=3
