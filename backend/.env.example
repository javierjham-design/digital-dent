# Backend de Cláriva — variables de entorno
# ───────────────────────────────────────────────────────────────────────────

# Base de datos. Es la MISMA que usa el monolito (single source of truth).
# En el cutover, el backend apunta a la DATABASE_URL de Postgres de Railway.
DATABASE_URL=postgresql://user:pass@host:5432/clariva

# Secreto para firmar los JWT que emite el backend.
# IMPORTANTE: para que las sesiones del monolito y del backend sean
# intercambiables durante la transición, reutilizar el MISMO valor que
# NEXTAUTH_SECRET del monolito. (El backend cae a NEXTAUTH_SECRET si no se define.)
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Orígenes del frontend permitidos por CORS (separados por coma, sin slash final).
# Para orígenes puntuales (p.ej. el dominio *.up.railway.app durante la transición).
CORS_ORIGINS=http://localhost:5173

# Dominio de la plataforma. Si se define, CORS permite el apex y CUALQUIER
# subdominio (cada clínica vive en <slug>.clariva.cl). Producción: clariva.cl
PLATFORM_DOMAIN=

PORT=4000
NODE_ENV=development

# Clave de cifrado AES-256-GCM (tokens de Twilio, refresh tokens de Google).
# DEBE ser EXACTAMENTE la misma que usa el monolito, o no se podrán descifrar
# los secretos ya guardados en la base.
ENCRYPTION_KEY=

# Secreto para el endpoint de sync de Google por cron (POST /google/sync).
CRON_SECRET=

# ── Meta Lead Ads (webhook nativo, compartido por toda la plataforma) ──────────
# Una sola App de Meta para toda la plataforma. Cada clínica autoriza su página
# y guarda su token de página en su Configuracion (encriptado). App secret valida
# la firma HMAC del webhook; el verify token lo defines tú (cualquier string) y
# debe coincidir con el que pegues en la config del webhook de la App de Meta.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Versión ÚNICA de la Graph API para TODAS las llamadas a Meta (CAPI web, emisor
# de etapas de CRM, webhook de Lead Ads). Opcional; por defecto v25.0.
META_GRAPH_VERSION=v25.0

# Google Calendar (opcional; solo si se usa la integración). El redirect URI
# debe apuntar al backend y estar registrado en Google Cloud Console:
#   https://<dominio-backend>/api/v1/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ── Observabilidad (ver docs/OBSERVABILIDAD.md) ────────────────────────────────
# Sentry: reporte de errores 5xx y excepciones no manejadas. OPCIONAL: sin DSN,
# Sentry queda apagado y el backend funciona igual (solo logs). Cargar en Railway.
# DSN del proyecto de backend (Settings → Projects → clariva-backend → Client Keys).
SENTRY_DSN=
# Entorno que se muestra en Sentry (production / staging). Por defecto usa NODE_ENV.
SENTRY_ENVIRONMENT=production
# Nivel mínimo de log: debug | info | warn | error. Por defecto info.
LOG_LEVEL=info
