// ─────────────────────────────────────────────────────────────────────────────
//  CONTROL-PLANE (1 base compartida)
//  Capa de negocio del SaaS: qué clínicas existen, su suscripción/facturación,
//  leads, administradores de la plataforma y auditoría. NO contiene datos
//  clínicos ni operativos de las clínicas — eso vive en la base de cada tenant.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../generated/control"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_DATABASE_URL")
}

// Registro de clínicas. `dbName` apunta a la base de datos física e
// independiente de esa clínica (database-per-tenant). El backend la resuelve
// por subdominio y abre la conexión correspondiente.
model Clinica {
  id    String @id @default(cuid())
  slug  String @unique
  dbName String @unique               // nombre de la base de datos del tenant

  nombre String                       // copia para mostrar en el super-admin
  rut    String? @unique
  email  String  @default("")         // contacto comercial (registro)
  telefono String @default("")

  plan       String   @default("TRIAL")
  pais       String   @default("CL")  // país de operación (define documento, teléfono y moneda). Solo el super-admin lo cambia.
  modulos    String   @default("crm,agendamiento_online,whatsapp") // módulos habilitados (CSV). Los asigna el super-admin.
  vertical   String   @default("dental") // rubro (dental|medico|estetica): define el área clínica con la que nace
  activo     Boolean  @default(true)
  trialHasta DateTime?

  // Hash (sha256) de la API key read-only de la clínica, para integraciones
  // externas (servidor MCP de Claude). Permite resolver la clínica por su key
  // sin abrir cada base. Se guarda hasheada; el token se muestra sólo al generarlo.
  // Índice NO único a propósito: el hash es aleatorio de 256 bits (colisión
  // imposible) y un @unique haría que `prisma db push` exija --accept-data-loss.
  apiKeyHash String?

  // Facturación de la suscripción (gestionado por super-admin).
  cicloFacturacion String    @default("MENSUAL") // MENSUAL | ANUAL
  profesionalesExtra Int     @default(0)   // profesionales con agenda adicionales al tope del plan ($9.990 c/u al mes)
  precioAcordado   Float?

  // Cobro de la suscripción. monedaCobro null = automática por país (CL→CLP, resto→USD).
  // cobroAutomatico: hay un medio guardado y se cobra recurrente. suscripcionProvider/Ref:
  // referencia de la suscripción en la pasarela (Flow para CLP, Stripe para USD).
  monedaCobro        String?   // CLP | USD | null(auto)
  cobroAutomatico    Boolean   @default(false)
  suscripcionProvider String?  // FLOW | STRIPE
  suscripcionRef      String?  // id de la suscripción/preapproval en la pasarela
  proximoCobro     DateTime?
  notasInternas    String?

  // Enrutamiento de WhatsApp (denormalizado desde la Configuracion del tenant):
  // el webhook de Twilio resuelve la clínica por su número emisor, y el cron de
  // recordatorios filtra las clínicas con el servicio activo sin abrir cada base.
  waEnabled Boolean @default(false)
  waNumero  String? @unique

  // Enrutamiento de Meta Lead Ads (denormalizado desde la Configuracion del
  // tenant): el webhook nativo de leadgen resuelve la clínica por el page_id
  // sin abrir cada base. NO @unique (evita que db push exija --accept-data-loss;
  // una página pertenece a una sola clínica de todos modos).
  metaPageId         String?
  metaLeadAdsEnabled Boolean @default(false)

  // Último acceso a la plataforma (se actualiza con throttle desde el middleware
  // de tenant). Para el super-admin. ...AdminAt: sólo cuando ingresa un admin de
  // la clínica (para saber si el dueño/administrador ha estado usando la app).
  ultimoAccesoAt      DateTime?
  ultimoAccesoAdminAt DateTime?

  // Demo autogenerada desde la landing (se elimina al expirar).
  esDemo       Boolean   @default(false)
  demoExpiraEn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pagosSuscripcion PagoSuscripcion[]
  extras           ExtraSuscripcion[]
  metodoPago       MetodoPagoClinica?

  @@index([esDemo])
  @@index([activo, plan])
  @@index([apiKeyHash])
}

// Prospecto capturado desde la landing/demo. Queda para ventas aunque la
// clínica demo se borre al expirar.
model Lead {
  id            String   @id @default(cuid())
  nombre        String
  email         String
  telefono      String?
  nombreClinica String?
  origen        String   @default("DEMO") // DEMO | CONTACTO
  rubro         String?  // dental | medico | estetica
  clinicaId     String?
  clinicaSlug   String?
  ip            String?
  notas         String?  // notas de gestión (equipo de ventas)
  // ── CRM de ventas de la plataforma ──
  estado        String   @default("NUEVO") // NUEVO | CONTACTADO | DEMO_ACTIVA | NEGOCIACION | GANADO | PERDIDO
  pais          String?  // país de la campaña/landing (CR/PA/CO/CL…)
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  gestionadoAt  DateTime? // última gestión del equipo de ventas
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([estado])
}

// Cargo adicional recurrente sobre el plan de una clínica.
model ExtraSuscripcion {
  id           String   @id @default(cuid())
  clinicaId    String
  codigo       String   @default("OTRO")
  nombre       String
  montoMensual Float
  activo       Boolean  @default(true)
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  clinica      Clinica  @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@index([clinicaId])
}

// Catálogo de planes de suscripción de la plataforma.
model PlanSuscripcion {
  id              String   @id
  nombre          String
  descripcion     String?
  precioMensual   Float    @default(0)  // valor en CLP
  precioMensualUSD Float   @default(0)  // valor en USD (para clínicas que se cobran en USD)
  precioAnual     Float?                // valor anual en CLP (opcional)
  precioAnualUSD  Float?                // valor anual en USD (opcional)
  maxProfesionales Int     @default(2) // tope de usuarios CON agenda (doctor/médico) del plan
  modulos         String   @default("crm,agendamiento_online,whatsapp") // módulos incluidos en el plan (CSV)
  caracteristicas String   @default("[]") // JSON string[]
  destacado       Boolean  @default(false)
  orden           Int      @default(0)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Pago de suscripción recibido desde una clínica (registro manual).
model PagoSuscripcion {
  id            String   @id @default(cuid())
  clinicaId     String
  fechaPago     DateTime @default(now())
  monto         Float
  periodoDesde  DateTime
  periodoHasta  DateTime
  moneda        String   @default("CLP") // CLP | USD (moneda en que se recibió el pago)
  metodoPago    String   // TRANSFERENCIA | WEBPAY | EFECTIVO | OTRO
  comprobante   String?
  notas         String?
  registradoPor String?
  createdAt     DateTime @default(now())
  clinica       Clinica  @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@index([clinicaId, fechaPago])
}

// Medio de pago guardado de una clínica (para cobro automático). Guarda SOLO
// metadatos y las referencias tokenizadas de la pasarela (Flow/Stripe), NUNCA el
// número de tarjeta ni el CVV — esos viven en la pasarela.
model MetodoPagoClinica {
  id          String   @id @default(cuid())
  clinicaId   String   @unique
  provider    String   // FLOW | STRIPE
  customerRef String?  // id del cliente en la pasarela
  tokenRef    String?  // id del medio tokenizado en la pasarela
  marca       String?  // VISA | MASTERCARD | ...
  ultimos4    String?
  exp         String?  // MM/AA
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinica     Clinica  @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
}

// Administradores de la PLATAFORMA (super-admins). Login por email. No están
// atados a ninguna clínica; viven solo en el control-plane.
model PlatformAdmin {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  password          String
  activo            Boolean   @default(true)
  passwordChangedAt DateTime?
  // 2FA TOTP (obligatorio para super-admin). El secreto va CIFRADO (AES-256-GCM,
  // lib/crypto). totpEnabled=false hasta que el admin confirma un código del QR.
  // totpBackupCodes = JSON de hashes bcrypt de códigos de respaldo de un solo uso.
  totpSecret        String?
  totpEnabled       Boolean   @default(false)
  totpBackupCodes   String?
  totpEnrolledAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Registro de cada corrida del job de backup lógico (capa 2). El super-admin lo
// consulta para el dead-man's switch (alertar si pasaron >36 h sin una corrida OK)
// y migrate-tenants lo usa para abortar si el último backup OK tiene más de 24 h.
model BackupRun {
  id            String    @id @default(cuid())
  iniciadoAt    DateTime  @default(now())
  terminadoAt   DateTime?
  estado        String    @default("ERROR") // OK | PARCIAL | ERROR
  basesTotal    Int       @default(0)
  basesOk       Int       @default(0)
  bytesTotal    BigInt    @default(0)
  manifiestoKey String?   // ruta del manifiesto en el bucket
  error         String?
  disparadoPor  String    @default("cron") // cron | manual | drill

  @@index([iniciadoAt])
  @@index([estado, iniciadoAt])
}

// Bitácora de acciones sensibles del super-admin.
model AuditLogAdmin {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String
  targetId   String?
  details    String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}
