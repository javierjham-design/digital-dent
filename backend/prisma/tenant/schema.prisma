// ─────────────────────────────────────────────────────────────────────────────
//  TENANT (1 base de datos por clínica — aislamiento físico)
//  Contiene TODOS los datos operativos de una clínica: equipo, pacientes,
//  agenda, fichas clínicas, presupuestos, cobros, caja, liquidaciones y su
//  configuración/integraciones. Como cada base ES una clínica, los modelos NO
//  llevan clinicaId. El backend abre la base correcta según el subdominio.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../generated/tenant"
}

datasource db {
  provider = "postgresql"
  // URL dinámica: en runtime se pasa la de cada clínica; este env es solo para
  // los comandos de Prisma CLI (generate / db push sobre una base concreta).
  url      = env("TENANT_DATABASE_URL")
}

// Perfil + integraciones de la clínica (singleton por base).
model Configuracion {
  id        String  @id @default("singleton")
  nombre    String  @default("Mi clínica")
  rut       String?
  direccion String  @default("")
  ciudad    String  @default("Temuco")
  telefono  String  @default("")
  whatsapp  String  @default("") // WhatsApp de la clínica (para derivar al paciente tras reservar online)
  email     String  @default("")
  logoUrl   String?
  mensajeWA String  @default("Hola {nombre}, te escribimos de *{clinica}* para confirmar tu cita el {fecha} en {direccion}.")
  // Mensaje base para escribir a un lead del CRM por WhatsApp (primer contacto).
  mensajeWACrm String @default("Hola {nombre}, te contactamos de *{clinica}*. ¿Cómo podemos ayudarte?")
  // Mensaje que el paciente envía por WhatsApp tras reservar online ({dia}/{hora} automáticos).
  mensajeReservaWA String @default("¡Hola! Ya agendé mi hora para el {dia} a las {hora} h. Quedo atento/a a la confirmación.")

  // WhatsApp (Twilio). El auth token va cifrado (AES-256-GCM).
  waEnabled     Boolean @default(false)
  waTwilioSid   String?
  waTwilioToken String?
  waNumero      String?
  waTemplateSid String?
  waHorasAntes  Int     @default(24)

  // Google Calendar (una cuenta por clínica). Tokens cifrados.
  googleRefreshToken    String?
  googleAccessToken     String?
  googleTokenExpiresAt  DateTime?
  googleAccountEmail    String?
  googleConnectedAt     DateTime?
  googleConnectedById   String?
  googleConnectedByName String?
  // Estado de la sincronización (Google → Cláriva). googleSyncError guarda el
  // último fallo de autenticación (token revocado/vencido); null = sano. La
  // "desactualización" (el sync dejó de correr) NO se guarda acá: se deriva del
  // último googleSyncedAt de los doctores (ver getGoogleHealth).
  googleSyncError       String?
  googleSyncErrorAt     DateTime?

  // Marketing / Meta (CRM). Pixel ID es público (se inyecta en el navegador);
  // el token de Conversions API es secreto (server-side). crmToken autentica el
  // endpoint público de captación de formularios web.
  metaEnabled   Boolean @default(false)
  metaPixelId   String?
  metaCapiToken String?
  metaTestCode  String?
  metaTestCodeHasta DateTime? // el test_event_code SOLO se aplica hasta esta fecha (auto-expira ~2h); pasado eso, se ignora y los eventos vuelven a contar
  // Integración de CRM (Conversions API para "Leads de conversión"): dataset y
  // token PROPIOS de cada clínica, DISTINTOS del pixel/token web de arriba (el
  // dataset de CRM es otro objeto de Meta). El token va encriptado (write-only).
  metaCrmEnabled     Boolean @default(false)
  metaCrmDatasetId   String?
  metaCrmAccessToken String? // encriptado con lib/crypto (nunca se devuelve en claro)
  // Recepción NATIVA de leads del Formulario Instantáneo (webhook leadgen). La
  // clínica autoriza su página de Facebook y guarda su token de página (larga
  // duración, encriptado). El page_id enruta el webhook a esta clínica.
  metaLeadAdsEnabled  Boolean @default(false)
  metaPageId          String?
  metaPageAccessToken String? // token de página encriptado (write-only)
  metaLeadAdsUltimo   String? // JSON con el último lead recibido (diagnóstico de la UI)
  crmToken      String?
  crmDiasSinGestion Int @default(4) // umbral de días para alertar leads sin gestionar
  crmCampanas   String? // JSON { [claveCampaña]: "Nombre visible" } — renombres de campaña (para no mostrar la URL)
  pais          String @default("CL") // país de operación (documento/teléfono/moneda); lo fija el super-admin

  // Cobro online a PACIENTES vía Flow (el dinero cae en la cuenta de la clínica,
  // por eso las credenciales son de la clínica). El secretKey se guarda CIFRADO
  // (AES-256-GCM). Nunca se devuelve por la API, solo un indicador de "configurado".
  pagoOnlineEnabled Boolean @default(false)
  flowApiKey        String? // cifrado
  flowSecretKey     String? // cifrado
  flowSandbox       Boolean @default(true) // true = ambiente de pruebas de Flow

  // Correo: las respuestas del paciente llegan al `email` de la clínica (Reply-To).
  // emailNotificaciones controla los envíos automáticos (ej. confirmación de hora).
  emailNotificaciones Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// Historial de correos enviados por la clínica (confirmaciones, presupuestos,
// consentimientos, documentos, comprobantes, planes, avisos de deuda…).
model EmailEnviado {
  id               String   @id @default(cuid())
  para             String
  asunto           String
  tipo             String   // CONFIRMACION_HORA | PRESUPUESTO | CONSENTIMIENTO | DOCUMENTO | COMPROBANTE | PLAN | DEUDA | OTRO
  pacienteId       String?
  estado           String   @default("ENVIADO") // ENVIADO | ERROR
  providerId       String?  // id del proveedor (Resend)
  error            String?
  enviadoPorId     String?
  enviadoPorNombre String?
  createdAt        DateTime @default(now())

  @@index([pacienteId, createdAt])
  @@index([tipo, createdAt])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  titulo        String    @default("") // Dr. | Dra. | Prof. | "" (se muestra delante del nombre)
  email         String?   @unique
  username      String?   @unique
  password      String
  role          String    @default("staff") // admin | doctor | staff
  rut           String?   @unique
  especialidad  String?
  telefono      String?
  activo        Boolean   @default(true)
  passwordChangedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  puedeRecibirPagos           Boolean @default(false)
  puedeModificarPrecio        Boolean @default(false)
  puedeAplicarDescuento       Boolean @default(false)
  puedeRevertirCompletado     Boolean @default(false)
  puedeEditarPagos            Boolean @default(false)
  puedeGestionarLiquidaciones Boolean @default(false)
  puedeGestionarCrm           Boolean @default(false)
  puedeEliminar               Boolean @default(false)
  puedeGestionarCajas         Boolean @default(false)
  puedeConfigurarClinica      Boolean @default(false) // Configuración, agendamiento online, consentimientos
  puedeGestionarEquipo        Boolean @default(false) // ver/crear/editar usuarios y sus permisos
  puedeGestionarPrestaciones  Boolean @default(false) // editar prestaciones y secciones del catálogo
  puedeDesbloquearPlanes      Boolean @default(false) // desbloquear presupuestos bloqueados (al imprimir/enviar quedan bloqueados)
  puedeGestionarAgenda        Boolean @default(false) // gestionar la agenda de cualquier profesional: bloqueos y citas (crear/editar/eliminar)
  puedeVerReportes            Boolean @default(false) // descargar los reportes XLSX (nómina de pacientes, cobros, morosos, etc.)
  // Áreas clínicas que trabaja el usuario (disponible = clínica contrató el área
  // Y el usuario la tiene). Dental default true: todos los usuarios actuales
  // siguen operando exactamente igual.
  areaDental                  Boolean @default(true)
  areaEstetica                Boolean @default(false)
  areaMedico                  Boolean @default(false)

  // Mapeo a un calendario de Google (dentro de la cuenta de la clínica).
  googleCalendarId String?
  googleSyncToken  String?
  googleSyncedAt   DateTime?

  citas              Cita[]            @relation("DoctorCitas")
  tratamientos       Tratamiento[]     @relation("DoctorTratamientos")
  contratos          Contrato[]
  montosFijos        MontoFijoPrestacion[]
  liquidaciones      Liquidacion[]
  horarios           HorarioDoctor[]
  cobrosRecibidos    Cobro[]           @relation("CobroUsuario")
  evolucionesCreadas Evolucion[]       @relation("AutorEvolucion")
  planesTitulares    PlanTratamiento[] @relation("DoctorTitularPlanes")
  cajas              CajaUsuario[]
  movimientosCaja    MovimientoCaja[]  @relation("MovimientoUsuario")
  bloqueosAgenda     BloqueoAgenda[]   @relation("DoctorBloqueos")
  linksAgenda        LinkAgenda[]
  linksAgendaProf    LinkAgendaProfesional[]
}

model Paciente {
  id               String    @id @default(cuid())
  numero           Int?      @unique
  rut              String?   @unique
  otroDocId        String?
  nombre           String
  apellido         String
  nombreSocial     String?
  fechaNacimiento  DateTime?
  genero           String?
  sexo             String?
  nacionalidad     String?
  migrante         String?
  puebloOriginario String?
  telefono         String?
  telefonoFijo     String?
  email            String?
  direccion        String?
  ciudad           String?
  comuna           String?
  prevision        String?
  actividad        String?
  empleador        String?
  apoderado        String?
  rutApoderado     String?
  referencia       String?
  tipoPaciente     String?
  numeroInterno    String?
  alergias         String?
  antecedentes     String?
  observaciones    String?
  contactoEmergencia String?
  telefonoEmergencia String?
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  citas            Cita[]
  fichaClinica     FichaClinica?
  presupuestos     Presupuesto[]
  planes           PlanTratamiento[]
  evoluciones      Evolucion[]
  cobros           Cobro[]
  comentariosAdmin ComentarioAdministrativo[]
  mensajes         MensajePaciente[]
  consentimientos  Consentimiento[]
  documentos       DocumentoPaciente[]
}

model ComentarioAdministrativo {
  id          String   @id @default(cuid())
  pacienteId  String
  autorNombre String
  autorId     String?
  texto       String
  createdAt   DateTime @default(now())
  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
}

model MensajePaciente {
  id         String   @id @default(cuid())
  pacienteId String
  citaId     String?
  tipo       String
  categoria  String
  asunto     String?
  cuerpo     String?
  enviadoA   String?
  estado     String   @default("ENVIADO")
  createdAt  DateTime @default(now())
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  cita       Cita?    @relation(fields: [citaId], references: [id])
}

model Cita {
  id           String   @id @default(cuid())
  pacienteId   String
  doctorId     String
  fecha        DateTime
  duracion     Int      @default(30)
  estado       String   @default("PENDIENTE")
  tipo         String?
  notas        String?
  sala         String?
  boxId        String?  // box/sala de atención (opcional; null = sin box asignado)
  sobrecupo    Boolean  @default(false)
  confirmadoWA Boolean  @default(false)
  origen       String?  // null = interna; "ONLINE" = reserva pública del paciente
  linkAgendaId String?  // link de agendamiento online que la generó
  abonoRequerido Boolean @default(false) // la reserva online exigía un abono (pago previo)
  abonoPagado    Boolean @default(false) // el abono fue confirmado por la pasarela (Flow)
  reservaRevisada Boolean @default(false) // reserva online ya aceptada por la clínica (sale de "por confirmar"; sigue Agendada)
  googleEventId   String?
  googleSyncedAt  DateTime?
  googleSyncError String?
  waMessageSid    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  paciente     Paciente @relation(fields: [pacienteId], references: [id])
  doctor       User     @relation("DoctorCitas", fields: [doctorId], references: [id])
  box          Box?     @relation(fields: [boxId], references: [id])
  logs         CitaLog[]
  mensajes     MensajePaciente[]

  @@index([googleEventId])
  @@index([waMessageSid])
  @@index([doctorId, fecha])
}

model CitaLog {
  id        String   @id @default(cuid())
  citaId    String
  tipo      String
  detalle   String
  userName  String   @default("Sistema")
  createdAt DateTime @default(now())
  cita      Cita     @relation(fields: [citaId], references: [id], onDelete: Cascade)
}

model FichaClinica {
  id                String        @id @default(cuid())
  pacienteId        String        @unique
  grupoSanguineo    String?
  fumador           Boolean       @default(false)
  embarazada        Boolean       @default(false)
  diabetico         Boolean       @default(false)
  hipertenso        Boolean       @default(false)
  cardiopatia       Boolean       @default(false)
  anticoagulantes   Boolean       @default(false)
  medicamentos      String?
  notasClinicas     String?
  alertasMedicas    String?
  enfermedadesNotas String?
  motivoAtencion    String?
  impresionMedica   String?
  resumenDiagnostico String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paciente          Paciente      @relation(fields: [pacienteId], references: [id])
  tratamientos      Tratamiento[]
  odontograma       Diente[]
  zonasFaciales     ZonaFicha[]
  dibujoFacial      DibujoFacial?
}

model Diente {
  id     String       @id @default(cuid())
  fichaId String
  numero Int
  cara   String?
  estado String       @default("SANO")
  color  String?
  notas  String?
  ficha  FichaClinica @relation(fields: [fichaId], references: [id])

  @@unique([fichaId, numero, cara])
}

model Prestacion {
  id               String            @id @default(cuid())
  nombre           String
  descripcion      String?
  precio           Float
  duracion         Int               @default(30)
  // `categoria` (string) es una COPIA DERIVADA del nombre de la categoría, mantenida
  // por compatibilidad. La fuente de verdad es `categoriaId`: con secciones homónimas
  // en áreas distintas ("General" dental y "General" estética), el nombre solo es
  // ambiguo. Todo write pasa por catalogo.service (helper único que escribe ambos);
  // el string se elimina en una tanda posterior (ver AI_CHANGELOG).
  categoria        String?
  categoriaId      String?
  categoriaRef     CategoriaPrestacion? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  activo           Boolean           @default(true)
  tratamientos     Tratamiento[]
  itemsPresupuesto ItemPresupuesto[]
  montosFijos      MontoFijoPrestacion[]
}

// Metadata de las secciones/categorías del catálogo de prestaciones. Se enlazan
// por nombre (Prestacion.categoria == CategoriaPrestacion.nombre). Permiten
// ordenar las secciones y marcar las NO liquidables (laboratorios/insumos que no
// se pagan al profesional y no cuentan en la liquidación).
model CategoriaPrestacion {
  id           String  @id @default(cuid())
  nombre       String
  // Área clínica de la sección (DENTAL | ESTETICA | MEDICO). Las prestaciones
  // HEREDAN el área de su categoría (no se etiquetan una por una). Todas las
  // categorías existentes quedan DENTAL por el default.
  area         String  @default("DENTAL")
  orden        Int     @default(0)
  noLiquidable Boolean @default(false)
  prestaciones Prestacion[]

  // Unicidad POR ÁREA: "General" dental y "General" estética son secciones
  // legítimas y distintas. (El unique global anterior era solo por nombre.)
  @@unique([nombre, area])
}

// ── Áreas clínicas: estética facial ──────────────────────────────────────────

// Catálogo de zonas faciales del tenant (equivalente del "diente" del odontograma).
// La lista vive en shared/constants/zonas-faciales.ts (ÚNICA fuente), CONGELADA por
// revisión profesional (2026-08-11) → apta para clínica real. Agregar zonas nuevas es
// barato; renombrar/fusionar exige migrar datos (el codigo queda grabado en cada
// tratamiento). `codigo` es la llave estable que mapea 1:1 con el id del path del SVG
// (`zona-{CODIGO}`), SIN el grupo adentro (el agrupamiento por tercios es
// presentación y puede cambiar; el código no). Lateralidad en el código
// (_IZQ/_DER), desde la PERSPECTIVA DEL PACIENTE (su _IZQ se dibuja a la derecha
// del espectador). Tres nombres separados: el clínico (ficha/historia) y el
// visible (presupuesto de la paciente) pueden cambiar sin tocar datos.
model ZonaFacial {
  id            String  @id @default(cuid())
  codigo        String  @unique
  nombreClinico String
  nombreVisible String
  grupo         String  // TERCIO_SUPERIOR | TERCIO_MEDIO | TERCIO_INFERIOR | GLOBAL
  orden         Int     @default(0)
  activo        Boolean @default(true)
  fichas       ZonaFicha[]
  tratamientos TratamientoZona[]
}

// Estado clínico por zona de cada ficha (espejo de Diente para estética).
model ZonaFicha {
  id      String       @id @default(cuid())
  fichaId String
  zonaId  String
  estado  String       @default("SANO")
  color   String?
  notas   String?
  ficha   FichaClinica @relation(fields: [fichaId], references: [id])
  zona    ZonaFacial   @relation(fields: [zonaId], references: [id])

  @@unique([fichaId, zonaId])
}

// Zonas de un tratamiento estético: UN tratamiento cubre N zonas con UN precio
// (un bótox de patas de gallo cubre ambos lados y se cobra una vez). NO es "un
// tratamiento por zona" como el patrón dental por pieza: eso duplicaría el precio
// en presupuesto/cobro y pagaría N veces el monto fijo en la liquidación.
model TratamientoZona {
  id            String      @id @default(cuid())
  tratamientoId String
  zonaId        String
  tratamiento   Tratamiento @relation(fields: [tratamientoId], references: [id], onDelete: Cascade)
  zona          ZonaFacial  @relation(fields: [zonaId], references: [id])

  @@unique([tratamientoId, zonaId])
}

// Dibujo libre sobre el gráfico facial (capa 2, anotación clínica). POR FICHA
// (como el odontograma, compartido entre planes): borrar un plan o un tratamiento
// JAMÁS toca los trazos, y viceversa. `trazos` = JSON de trazos VECTORIALES
// [{herramienta, color, grosor, puntos:[{x,y}…]}] con coordenadas normalizadas al
// viewBox del SVG (editable y escalable; nunca imagen rasterizada). Un trazo no
// genera prestaciones ni aparece en presupuestos: no hay FK a plan/tratamiento.
// `genero` = ilustración elegida (F/M); si no hay fila, la UI deriva de
// Paciente.sexo.
model DibujoFacial {
  id        String       @id @default(cuid())
  fichaId   String       @unique
  genero    String       @default("F")
  trazos    String       @default("[]")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  ficha     FichaClinica @relation(fields: [fichaId], references: [id])
}

model Tratamiento {
  id              String           @id @default(cuid())
  fichaId         String
  planId          String?
  seccionId       String?
  prestacionId    String
  doctorId        String?
  diente          Int?
  cara            String?
  estado          String           @default("PLANIFICADO")
  precio          Float
  descuento       Float            @default(0)
  notas           String?
  paraCobro       Boolean          @default(false) // marcada con el "carrito" para incluirla en la próxima recaudación
  fecha           DateTime         @default(now())
  fechaCompletado DateTime?
  ficha           FichaClinica     @relation(fields: [fichaId], references: [id])
  plan            PlanTratamiento? @relation(fields: [planId], references: [id], onDelete: SetNull)
  seccion         SeccionPlan?     @relation(fields: [seccionId], references: [id], onDelete: SetNull)
  prestacion      Prestacion       @relation(fields: [prestacionId], references: [id])
  doctor          User?            @relation("DoctorTratamientos", fields: [doctorId], references: [id])
  liquidacionItems LiquidacionItem[]
  cobroItems      CobroItem[]
  evoluciones     Evolucion[]
  // Zonas faciales (solo tratamientos estéticos; N zonas, UN precio). Un
  // tratamiento dental usa diente/cara; uno médico no usa ninguno de los tres.
  zonas           TratamientoZona[]
}

model PlanTratamiento {
  id              String        @id @default(cuid())
  pacienteId      String
  doctorTitularId String?
  nombre          String        @default("Plan de tratamiento")
  area            String        @default("DENTAL") // DENTAL | ESTETICA | MEDICO — un plan = un área; solo admite acciones de esa área
  estado          String        @default("ACTIVO")
  bloqueado       Boolean       @default(false)  // bloqueo al imprimir; desbloquear para editar
  notas           String?
  fechaInicio     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paciente        Paciente      @relation(fields: [pacienteId], references: [id])
  doctorTitular   User?         @relation("DoctorTitularPlanes", fields: [doctorTitularId], references: [id])
  secciones       SeccionPlan[]
  tratamientos    Tratamiento[]
}

model SeccionPlan {
  id                String          @id @default(cuid())
  planId            String
  titulo            String          @default("Sección")
  orden             Int             @default(0)
  fechaTentativa    DateTime?
  diasDesdeAnterior Int?            // cantidad de tiempo estimado (se interpreta según tiempoUnidad)
  tiempoUnidad      String          @default("DIAS") // DIAS | SEMANAS | MESES
  notas             String?
  plan              PlanTratamiento @relation(fields: [planId], references: [id], onDelete: Cascade)
  tratamientos      Tratamiento[]
}

model Evolucion {
  id            String       @id @default(cuid())
  pacienteId    String
  tratamientoId String?
  autorId       String?
  texto         String
  fecha         DateTime     @default(now()) // fecha clínica de la evolución (editable)
  createdAt     DateTime     @default(now())
  paciente      Paciente     @relation(fields: [pacienteId], references: [id])
  tratamiento   Tratamiento? @relation(fields: [tratamientoId], references: [id], onDelete: SetNull)
  autor         User?        @relation("AutorEvolucion", fields: [autorId], references: [id])
}

// Bitácora de auditoría: registro inmutable de quién hizo qué y cuándo sobre los
// datos clínicos del paciente. Requisito legal de trazabilidad de la ficha
// clínica (Ley 20.584 / Ley 21.719). No se edita ni se borra desde la app.
model AuditLog {
  id           String   @id @default(cuid())
  fecha        DateTime @default(now())
  userId       String?
  userNombre   String?
  accion       String   // CREAR | EDITAR | EVOLUCIONAR | ELIMINAR
  entidad      String   // Paciente | FichaClinica | Evolucion | Tratamiento | PlanTratamiento | Cobro
  entidadId    String?
  pacienteId   String?
  resumen      String
  datosPrevios String?  // estado anterior (JSON) en ediciones/borrados

  @@index([pacienteId, fecha])
}

model Presupuesto {
  id         String            @id @default(cuid())
  pacienteId String
  numero     Int               @unique
  estado     String            @default("PENDIENTE")
  total      Float             @default(0)
  notas      String?
  vigencia   DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  paciente   Paciente          @relation(fields: [pacienteId], references: [id])
  items      ItemPresupuesto[]
}

model ItemPresupuesto {
  id             String      @id @default(cuid())
  presupuestoId  String
  prestacionId   String
  diente         Int?
  cantidad       Int         @default(1)
  precioUnitario Float
  descuento      Float       @default(0)
  subtotal       Float
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id])
  prestacion     Prestacion  @relation(fields: [prestacionId], references: [id])
}

model MedioPago {
  id                 String  @id @default(cuid())
  nombre             String
  comision           Float   @default(0)
  activo             Boolean @default(true)
  requiereReferencia Boolean @default(false) // pagos con tarjeta exigen N° de operación
  cobros             Cobro[] @relation("CobroMedio")
  cobros2            Cobro[] @relation("CobroMedio2")
}

model Cobro {
  id               String     @id @default(cuid())
  pacienteId       String
  numero           Int        @unique
  concepto         String
  monto            Float
  montoNeto        Float?
  comisionMonto    Float?
  estado           String     @default("PENDIENTE")
  medioPagoId      String?
  metodoPago       String?
  // Pago DIVIDIDO en un segundo medio: monto2 va al medioPago2, el resto (monto − monto2)
  // al medioPago principal. La suma siempre iguala el total del cobro (acciones/abono).
  medioPago2Id     String?
  monto2           Float?
  numeroReferencia2 String?
  reciboUsuarioId  String?
  cajaId           String?
  fechaPago        DateTime?
  notas            String?
  numeroReferencia String?    // N° de operación (obligatorio en pagos con tarjeta)
  numeroBoleta     String?    // N° de boleta (opcional, cualquier pago)
  anulado          Boolean    @default(false)
  motivoAnulacion  String?
  anuladoAt        DateTime?
  anuladoPorId     String?
  anuladoPorNombre String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  paciente         Paciente   @relation(fields: [pacienteId], references: [id])
  medioPago        MedioPago? @relation("CobroMedio",  fields: [medioPagoId],  references: [id])
  medioPago2       MedioPago? @relation("CobroMedio2", fields: [medioPago2Id], references: [id])
  reciboUsuario    User?      @relation("CobroUsuario", fields: [reciboUsuarioId], references: [id])
  caja             Caja?      @relation(fields: [cajaId], references: [id])
  items            CobroItem[]
  movimientos      MovimientoCaja[]
  pagosOnline      PagoOnline[]
}

model Caja {
  id           String       @id @default(cuid())
  // @unique es la red de seguridad del correlativo (lo asigna siguienteNumero con
  // advisory lock; un duplicado ahora falla ruidoso en vez de pasar en silencio).
  // El @default(0) quedó INERTE a propósito: los 3 paths de inserción (crearCaja,
  // abrirCajaParaUsuario, abrirSesionCore) setean numero explícito, y ningún seed crea
  // cajas. NO se quita porque sacarlo obliga a un `db push --accept-data-loss` sobre
  // bases productivas (regla 1 de CLAUDE.md: migrate-tenants nunca usa ese flag). Con el
  // @unique, aunque algo insertara sin numero, el segundo 0 rebotaría contra el constraint.
  numero       Int          @unique @default(0)
  nombre       String       @unique
  descripcion  String?
  saldoInicial Float        @default(0)
  activo       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  usuarios     CajaUsuario[]
  movimientos  MovimientoCaja[]
  cobros       Cobro[]
  sesiones     SesionCaja[]
}

model SesionCaja {
  id               String    @id @default(cuid())
  // @unique como red del correlativo de aperturas (mismo criterio que Caja.numero de
  // arriba). @default(0) inerte: abrirSesionCore setea numero explícito y ningún seed crea
  // sesiones; se conserva para no forzar un push --accept-data-loss sobre bases productivas.
  numero           Int       @unique @default(0)
  cajaId           String
  estado           String    @default("ABIERTA")
  saldoApertura    Float     @default(0)
  abiertaPorId     String
  abiertaPorNombre String?
  abiertaAt        DateTime  @default(now())
  cerradaPorId     String?
  cerradaPorNombre String?
  cerradaAt        DateTime?
  saldoEsperado    Float?
  saldoReal        Float?    // efectivo CONTADO al cerrar
  diferencia       Float?    // saldoReal - saldoEsperado (cuadrada / a favor / en contra)
  efectivoRetirado Float?    // efectivo que se retira de la caja al cerrar (depósito/entrega)
  efectivoDejado   Float?    // efectivo que queda en la caja para la próxima apertura
  totalIngresos    Float?
  totalEgresos     Float?
  observaciones    String?
  createdAt        DateTime  @default(now())
  caja             Caja      @relation(fields: [cajaId], references: [id])
  movimientos      MovimientoCaja[]

  @@index([cajaId, estado])
  @@index([cajaId, abiertaAt])
}

model CajaUsuario {
  cajaId String
  userId String
  caja   Caja @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cajaId, userId])
}

model MovimientoCaja {
  id               String      @id @default(cuid())
  cajaId           String
  sesionCajaId     String?
  tipo             String
  monto            Float
  descripcion      String
  categoria        String?
  fecha            DateTime    @default(now())
  cobroId          String?
  userId           String
  anulado          Boolean     @default(false)
  motivoAnulacion  String?
  anuladoAt        DateTime?
  anuladoPorId     String?
  anuladoPorNombre String?
  createdAt        DateTime    @default(now())
  caja             Caja        @relation(fields: [cajaId], references: [id])
  cobro            Cobro?      @relation(fields: [cobroId], references: [id])
  user             User        @relation("MovimientoUsuario", fields: [userId], references: [id])
  sesion           SesionCaja? @relation(fields: [sesionCajaId], references: [id])

  @@index([cajaId, fecha])
  @@index([sesionCajaId])
}

// Pago online (link de pago) de un cobro de PACIENTE vía Flow. Guarda el ciclo de
// vida del link y la conciliación por webhook. No reemplaza al Cobro; lo paga.
model PagoOnline {
  id            String    @id @default(cuid())
  cobroId       String?
  citaId        String?   // si el pago es el abono de una reserva online, la cita a confirmar
  pacienteId    String?
  proveedor     String    @default("FLOW")
  concepto      String
  monto         Float
  estado        String    @default("CREADO") // CREADO | PENDIENTE | PAGADO | RECHAZADO | ANULADO
  commerceOrder String?   @unique // orden que enviamos a Flow (idempotencia/conciliación)
  flowToken     String?   // token que devuelve Flow
  url           String?   // URL de pago para el paciente
  email         String?
  pagadoAt      DateTime?
  creadoPorId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cobro         Cobro?    @relation(fields: [cobroId], references: [id], onDelete: SetNull)

  @@index([cobroId])
  @@index([estado, createdAt])
}

model CobroItem {
  id            String       @id @default(cuid())
  cobroId       String
  tratamientoId String?
  planId        String?      // abono libre a un plan (sin acción específica)
  descripcion   String
  monto         Float
  cobro         Cobro        @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  tratamiento   Tratamiento? @relation(fields: [tratamientoId], references: [id])

  @@index([planId])
}

model Contrato {
  id            String        @id @default(cuid())
  doctorId      String
  tipo          String
  porcentaje    Float?
  montoFijo     Float?
  descripcion   String?
  fechaInicio   DateTime      @default(now())
  fechaFin      DateTime?
  activo        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  doctor        User          @relation(fields: [doctorId], references: [id])
  liquidaciones Liquidacion[]
}

// Monto fijo que un profesional cobra por una PRESTACIÓN específica (capa de override
// sobre su contrato base). Al liquidar un tratamiento de esa prestación se paga
// min(montoFijo, montoPagado) − retención del medio de pago; si lo cobrado es menor al
// fijo, se otorga el máximo disponible (lo cobrado) − retención. Se ata al PROFESIONAL
// (no al Contrato) para que sobreviva a la recreación del contrato al editar el % base.
model MontoFijoPrestacion {
  id           String     @id @default(cuid())
  doctorId     String
  prestacionId String
  montoFijo    Float
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  doctor       User       @relation(fields: [doctorId], references: [id])
  prestacion   Prestacion @relation(fields: [prestacionId], references: [id])

  @@unique([doctorId, prestacionId])
}

model Liquidacion {
  id             String            @id @default(cuid())
  doctorId       String
  contratoId     String
  periodo        String
  totalBruto     Float             @default(0)
  totalLiquidado Float             @default(0)
  estado         String            @default("BORRADOR")
  notas          String?
  fechaPago      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  doctor         User              @relation(fields: [doctorId], references: [id])
  contrato       Contrato          @relation(fields: [contratoId], references: [id])
  items          LiquidacionItem[]
  adjuntos       LiquidacionAdjunto[]
}

// Archivos asociados a una liquidación (factura del profesional, comprobante de
// transferencia). Se guardan como bytes en la base de la clínica.
model LiquidacionAdjunto {
  id              String      @id @default(cuid())
  liquidacionId   String
  tipo            String      // FACTURA | COMPROBANTE
  nombre          String      // nombre original del archivo
  mime            String
  size            Int
  data            Bytes
  subidoPorId     String?
  subidoPorNombre String?
  createdAt       DateTime    @default(now())
  liquidacion     Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)

  @@index([liquidacionId])
}

model LiquidacionItem {
  id                 String      @id @default(cuid())
  liquidacionId      String
  tratamientoId      String
  prestacionNombre   String
  pacienteNombre     String
  diente             String?
  fechaCompletado    DateTime
  precioTratamiento  Float
  porcentajeAplicado Float?
  montoFijoAplicado  Float?
  montoPagado        Float       @default(0)  // lo que el paciente pagó por la acción
  comisionAplicada   Float       @default(0)  // comisión del medio de pago descontada
  medioPago          String?                  // medio(s) de pago de la acción
  montoLiquidado     Float                    // total pagado al profesional (neto)
  origenCalculo      String?                  // PORCENTAJE | MONTO_FIJO | MONTO_FIJO_PRESTACION
  liquidacion        Liquidacion @relation(fields: [liquidacionId], references: [id])
  tratamiento        Tratamiento @relation(fields: [tratamientoId], references: [id])
}

model HorarioDoctor {
  id              String  @id @default(cuid())
  doctorId        String
  diaSemana       Int
  horaInicio      String
  horaFin         String
  activo          Boolean @default(true)
  recesoActivo    Boolean @default(false)
  recesoInicio    String?
  recesoFin       String?
  sobrecupoActivo Boolean @default(false)
  sobrecupoInicio String?
  sobrecupoFin    String?
  boxId           String? // box/sala por defecto de este bloque de atención (opcional)
  doctor          User    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  box             Box?    @relation(fields: [boxId], references: [id])

  @@unique([doctorId, diaSemana])
}

// Box / sala de atención (opcional y configurable: Box, Pabellón, Estética…). Si
// la clínica no configura ninguno, la agenda funciona igual (citas "sin box").
model Box {
  id        String   @id @default(cuid())
  nombre    String
  tipo      String?  // etiqueta libre informativa (Box, Pabellón, Estética…)
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  citas     Cita[]
  horarios  HorarioDoctor[]

  @@index([activo, orden])
}

model BloqueoAgenda {
  id            String   @id @default(cuid())
  doctorId      String
  inicio        DateTime
  fin           DateTime
  motivo        String?
  createdById   String?
  createdByName String?
  googleEventId   String?
  googleSyncedAt  DateTime?
  googleSyncError String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  doctor        User     @relation("DoctorBloqueos", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, inicio])
  @@index([googleEventId])
}

// Link público de agendamiento online. Cada link reserva citas para un
// profesional, con un tipo/etiqueta y duración fijos. La disponibilidad es
// híbrida: usa el horario del profesional, o ventanas exclusivas propias.
model LinkAgenda {
  id                  String   @id @default(cuid())
  token               String   @unique          // identificador público en la URL
  nombre              String
  descripcion         String?
  doctorId            String
  tipoCita            String   @default("EVALUACION") // se guarda en Cita.tipo
  comentarioCita      String?  // comentario fijo que se agrega a la cita (origen/campaña, ej. "Promoción Limpieza")
  duracionMin         Int      @default(30)
  usaHorarioDoctor    Boolean  @default(true)   // false → usa solo sus ventanas
  anticipacionHoras   Int      @default(12)     // antelación mínima para reservar
  diasMaxFuturo       Int      @default(30)     // ventana de reserva hacia adelante
  requierePago        Boolean  @default(false)  // exige un abono (vía Flow) para confirmar la hora
  montoAbono          Int      @default(0)      // monto del abono en la moneda local (CLP)
  mensajeConfirmacion String?
  color               String?
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  doctor              User     @relation(fields: [doctorId], references: [id])
  ventanas            LinkAgendaVentana[]
  profesionales       LinkAgendaProfesional[]

  @@index([doctorId])
}

// Profesionales disponibles en un link (uno o varios). doctorId es el primario;
// esta tabla guarda el conjunto completo que el paciente puede elegir.
model LinkAgendaProfesional {
  linkId String
  userId String
  link   LinkAgenda @relation(fields: [linkId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([linkId, userId])
  @@index([userId])
}

// Ventana semanal recurrente exclusiva de un link (cuando no usa el horario
// del profesional). Ej: día 1 (lunes) 15:00–18:00 = solo evaluaciones online.
model LinkAgendaVentana {
  id         String     @id @default(cuid())
  linkId     String
  diaSemana  Int        // 0=domingo … 6=sábado
  horaInicio String     // "15:00"
  horaFin    String     // "18:00"
  link       LinkAgenda @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
}

// CRM: prospecto captado por formulario web, campaña de Meta, reserva online, etc.
model Lead {
  id            String     @id @default(cuid())
  nombre        String
  apellido      String?
  telefono      String?
  email         String?
  rut           String?
  motivo        String?
  tratamiento   String?    // tratamiento de interés (Implantes, Ortodoncia, etc.)
  piezasReemplazar   String? // dato dental de la campaña (piezas a reemplazar)
  tiempoDesdePerdida String? // hace cuánto perdió la(s) pieza(s)
  estado        String     @default("NUEVO")      // NUEVO | CONTACTADO | AGENDADO | CONVERTIDO | PERDIDO
  origen        String     @default("FORMULARIO")  // FORMULARIO | META | INSTAGRAM | AGENDA_ONLINE | MANUAL | OTRO
  campana       String?
  externalId    String?    // id externo del lead — mejora el Event Match Quality de Meta
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  // Click-ids por plataforma (multi-canal)
  fbclid        String?
  ctwaClid      String?    // Click-to-WhatsApp (Meta)
  gclid         String?    // Google Ads
  msclkid       String?    // Microsoft Ads
  ttclid        String?    // TikTok
  twclid        String?    // X / Twitter
  liFatId       String?    // LinkedIn
  igclid        String?    // Instagram
  dclid         String?    // Google Display / DV360
  fbp           String?
  fbc           String?
  referrer      String?
  landing       String?
  tituloPagina  String?
  pantalla      String?    // resolución de pantalla (px)
  locale        String?
  ip            String?
  userAgent     String?
  primeraVisita DateTime?
  ultimaVisita  DateTime?
  fechaAgenda   DateTime?  // fecha/hora de la cita agendada
  agendaFuente  String?    // fuente del agendamiento (link, recepción, etc.)
  asistio       Boolean?   // asistió a la cita (null = desconocido)
  pacienteId    String?    // si se convierte en paciente
  citaId        String?    // si agenda una cita
  responsableId String?    // usuario a cargo del seguimiento
  metaEventId   String?    // id de evento (Lead) para deduplicar con el Pixel del navegador
  metaEnviado   Boolean    @default(false)
  leadgenId     String?    // leadgen_id del Formulario Instantáneo de Meta (llave para atar Schedule → Leads de conversión)
  camposExtra   String?    // JSON con los campos del Formulario Meta que no mapearon a un campo conocido (no se pierden)
  metaCrmEtapas String?    // etapas de CRM ya emitidas al dataset de Meta (CSV, ej. "lead_1,Schedule_1") — idempotencia
  crmScheduleEnviado Boolean @default(false) // Schedule CRM confirmado en el dataset (SEPARADO de scheduleCapiEnviado del landing)
  // Reingreso de contactos: un lead cuyo teléfono/email ya existía no se duplica,
  // sino que "vuelve a entrar". El CRM ordena por ultimoIngresoAt para subirlo al tope.
  ultimoIngresoAt DateTime? // fecha del último ingreso (creación o reingreso). Orden del listado.
  vecesIngresado  Int       @default(1) // cuántas veces ingresó este contacto (1 = solo el original)
  ingresos        String?   // JSON array: historial de toques (fecha, origen, campaña, ids de atribución)
  ultimoOrigen    String?   // atribución de ÚLTIMO toque (no pisa la original del primer toque)
  ultimaCampana   String?
  ultimoLeadgenId String?
  scheduleEventId     String?  // event_id del evento Schedule (dedup con el Pixel)
  scheduleCapiEnviado Boolean @default(false)
  ultimaGestionAt DateTime @default(now()) // última gestión HUMANA (nota, cambio de estado, agendar…), no escrituras del sistema
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  notas         LeadNota[]

  @@index([estado, createdAt])
  @@index([estado, ultimaGestionAt])
  @@index([origen])
}

// Timeline de un lead: notas manuales y cambios de estado.
model LeadNota {
  id          String   @id @default(cuid())
  leadId      String
  autorId     String?
  autorNombre String?
  tipo        String   @default("NOTA") // NOTA | ESTADO | SISTEMA
  texto       String
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// ── Consentimientos informados ────────────────────────────────────────────────
// Plantilla editable por clínica (se precargan las base de Digital Dent).
model PlantillaConsentimiento {
  id               String   @id @default(cuid())
  categoria        String   @default("CONSENTIMIENTO") // CONSENTIMIENTO | RECETA | CERTIFICADO | INDICACION | OTRO
  codigo           String   // DD-CI-01, etc.
  titulo           String
  contenidoHtml    String   // HTML con variables {{...}}
  camposRequeridos String   @default("nombre,rut,fechaNacimiento") // CSV de campos del paciente exigidos
  activo           Boolean  @default(true)
  orden            Int      @default(0)
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([activo, orden])
  @@index([categoria, activo])
}

// Consentimiento GENERADO para un paciente. Guarda el snapshot exacto firmado
// (integridad legal). Solo un admin puede eliminarlo (queda auditado).
model Consentimiento {
  id               String   @id @default(cuid())
  pacienteId       String
  plantillaId      String?
  categoria        String   @default("CONSENTIMIENTO") // CONSENTIMIENTO | RECETA | CERTIFICADO | INDICACION | OTRO
  codigo           String
  titulo           String
  contenidoHtml    String   // snapshot renderizado (con datos del paciente)
  estado           String   @default("BORRADOR") // BORRADOR | FIRMADO
  firmaTipo        String?  // MANUAL | DIGITAL
  firmaPacienteImg String?  // dataURL de la firma digital
  firmadoNombre    String?
  firmadoDocumento String?
  firmadoAt        DateTime?
  generadoPorId    String?  // usuario que operó la generación (auditoría)
  generadoPorNombre String?
  responsableId    String?  // profesional con agenda responsable clínico del consentimiento
  responsableNombre String?
  planId           String?  // plan de tratamiento asociado
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  paciente         Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId, createdAt])
  @@index([estado])
}

// ── Radiografías y documentos del paciente ────────────────────────────────────
// Imágenes (periapicales, bitewings, panorámicas…) y PDFs (informes). Se guardan
// como bytes en la base de la clínica (cuentan en el almacenamiento facturable).
model DocumentoPaciente {
  id              String   @id @default(cuid())
  pacienteId      String
  tipo            String   // PERIAPICAL | BITEWING_IZQ | BITEWING_DER | PANORAMICA | TELERRADIOGRAFIA | CBCT | FOTO | INFORME | OTRO
  dientes         String?  // CSV FDI de las piezas que aparecen (periapicales/bitewings)
  descripcion     String?
  nombre          String   // nombre original del archivo
  mime            String
  size            Int
  data            Bytes
  subidoPorId     String?
  subidoPorNombre String?
  createdAt       DateTime @default(now())
  paciente        Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId, createdAt])
}
